# Copie para `.env` (não vai para o git). Valores abaixo servem SOMENTE para desenvolvimento local.
# Em qualquer ambiente real, use segredos próprios e nunca reaproveite estes.

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=igreja
POSTGRES_PASSWORD=igreja_dev_only
POSTGRES_DB=igreja
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://igreja:igreja_dev_only@localhost:5432/igreja

# --- Autenticação (ADR 0010) ---
# Segredo que assina os tokens de acesso. OBRIGATÓRIO, mínimo de 32 caracteres, e propositalmente SEM valor aqui:
# um segredo de exemplo esquecido permitiria forjar logins. Gere um próprio e não o compartilhe nem o versione:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Validade do token de acesso, em segundos (60 a 3600). Padrão: 900 (15 minutos).
# ACCESS_TOKEN_TTL_SECONDS=900
# Validade deslizante do token de renovação, em dias (1 a 90). Padrão: 30.
# REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP (ADR 0011) ---
# Origens de navegador autorizadas a chamar a API, separadas por vírgula (protocolo://host[:porta], sem barra final).
# Vazia = nenhuma origem cruzada. Em desenvolvimento, o front (Vite) roda em http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
# Limite de taxa por IP: no máximo THROTTLE_LIMIT requisições a cada THROTTLE_TTL_SECONDS. Padrão: 100 a cada 60 s.
# THROTTLE_LIMIT=100
# THROTTLE_TTL_SECONDS=60

# --- Testes de integração (banco separado) ---
TEST_DATABASE_URL=postgresql://igreja:igreja_dev_only@localhost:5432/igreja_test
