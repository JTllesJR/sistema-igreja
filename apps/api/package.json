{
  "name": "@igreja/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST do sistema de gestão de igreja (monólito modular NestJS)",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --env-file ../../.env",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "cli": "nest build && node --env-file-if-exists=../../.env dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@igreja/contracts": "workspace:*",
    "@nestjs/common": "~12.1.3",
    "@nestjs/core": "~12.1.3",
    "@nestjs/platform-express": "~12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "helmet": "^8.3.0",
    "jose": "~6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "5.33.1",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "~12.0.8",
    "@nestjs/schematics": "~12.0.7",
    "@nestjs/testing": "~12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
