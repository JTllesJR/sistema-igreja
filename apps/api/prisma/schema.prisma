// Schema do banco. Convenções (ver docs/modelo-dominio.md):
//  - tabelas e colunas em snake_case no banco, camelCase no código (@@map / @map)
//  - ids UUID v7 GERADOS PELO DOMÍNIO (porta IdGenerator, ADR 0009); o banco não tem default de id
//  - timestamps com fuso (timestamptz)
//  - toda tabela de negócio carrega organization_id (ADR 0003)
//
// ATENÇÃO: duas regras do módulo organization NÃO aparecem aqui porque o Prisma não as expressa
// (índice único parcial e índice único funcional). Elas vivem em SQL manual na migration
// `*_organization_congregations` e devem ser preservadas ao alterar a tabela `congregation`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // O projeto é ESM com moduleResolution nodenext: imports relativos precisam terminar em .js.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CongregationStatus {
  ACTIVE
  INACTIVE

  @@map("congregation_status")
}

/// A igreja/denominação que usa o sistema (tenant). Raiz de todo o isolamento de dados.
model Organization {
  id        String   @id @db.Uuid
  name      String
  /// Travamento otimista: incrementada a cada gravação do agregado (ADR 0009, seção 5).
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  congregations     Congregation[]
  users             UserAccount[]
  roles             Role[]
  members           Member[]
  financialAccounts FinancialAccount[]
  financeCategories FinanceCategory[]

  @@map("organization")
}

/// Unidade local da igreja. Congregação não é excluída: fica ACTIVE ou INACTIVE.
model Congregation {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  isHeadquarters Boolean            @default(false) @map("is_headquarters")
  status         CongregationStatus @default(ACTIVE)
  /// JSON validado pela aplicação (value object Address). Nulo = sem endereço.
  address        Json?
  /// JSON validado pela aplicação (lista de ServiceTime).
  serviceTimes   Json               @default("[]") @map("service_times")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments       UserRoleAssignment[]
  members           Member[]
  financialAccounts FinancialAccount[]
  eventsFrom        MemberHistoryEvent[] @relation("EventFromCongregation")
  eventsTo          MemberHistoryEvent[] @relation("EventToCongregation")

  // Permite que outras tabelas usem FK composta (organization_id, congregation_id), impedindo que um
  // registro aponte para uma congregação de outra organização (ver docs/diagramas/modelo-er.md).
  @@unique([organizationId, id])
  @@map("congregation")
}

// ---------------------------------------------------------------------------------------------------------------
// identity-access (ADR 0010). Regras que o Prisma não expressa estão em SQL manual na migration
// `*_identity_access` (CHECK do e-mail normalizado, nome de papel único sem diferenciar caixa e as duas unicidades
// parciais das atribuições). Preserve-as ao alterar estas tabelas.
// ---------------------------------------------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// Pessoa que entra no sistema. Pertence a UMA igreja. (`user` é palavra reservada no PostgreSQL.)
model UserAccount {
  id                  String     @id @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  /// Sempre normalizado (minúsculas, sem espaços nas pontas) e único em TODO o sistema.
  email               String     @unique
  /// Hash argon2id em formato PHC. Nunca a senha.
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(ACTIVE)
  /// Entrou com senha temporária (ADR 0014): até escolher a própria senha, a API só atende /auth/*.
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Travamento otimista.
  version             Int        @default(0)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  UserRoleAssignment[]
  sessions     Session[]

  @@unique([organizationId, id])
  @@map("user_account")
}

/// Conjunto de permissões, por igreja. `is_system` = papel de sistema (ex.: Administrador), não editável.
model Role {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  assignments  UserRoleAssignment[]

  @@unique([organizationId, id])
  @@map("role")
}

/// "modulo:acao" ou "*" (curinga: concede tudo).
model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permission")
}

/// Usuário + papel + escopo. `congregation_id` nulo = vale para a igreja toda. As FKs são COMPOSTAS com
/// `organization_id`: o banco recusa um papel, usuário ou congregação de outra igreja.
model UserRoleAssignment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  congregationId String?  @map("congregation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         UserAccount   @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  role         Role          @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  congregation Congregation? @relation(fields: [organizationId, congregationId], references: [organizationId, id], onDelete: Restrict)

  @@map("user_role_assignment")
}

/// Uma linha da cadeia de renovação de um login. Guarda só o HASH do token (nunca o token).
model Session {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// Todas as sessões geradas por rotação a partir de um mesmo login compartilham a família.
  familyId        String    @map("family_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  familyStartedAt DateTime  @map("family_started_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt       DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  user UserAccount @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@index([familyId])
  @@index([userId])
  @@map("session")
}

// ---------------------------------------------------------------------------------------------------------------
// members (ADR 0013). Regras que o Prisma não expressa estão em SQL manual na migration `*_members_audit`
// (limites de tamanho por CHECK e o gatilho que torna `audit_log` somente-anexação). Preserve-as ao alterar.
// Dados de membros são SENSÍVEIS (convicção religiosa, LGPD art. 5º, II; ADR 0006).
// ---------------------------------------------------------------------------------------------------------------

/// Situação do membro na igreja. Valores provisórios, a validar com a igreja (casos de uso, pergunta 1).
enum MemberStatus {
  ACTIVE
  AWAY
  TRANSFERRED_OUT
  DECEASED

  @@map("member_status")
}

enum MemberEventType {
  REGISTERED
  BAPTISM
  RECEPTION
  TRANSFER
  STATUS_CHANGE
  ANONYMIZED

  @@map("member_event_type")
}

/// Pessoa cadastrada em UMA congregação. Nunca é excluída: é anonimizada (dados pessoais apagados, linha mantida).
/// Cargo na igreja (DADO SENSÍVEL). Lista informada pela igreja em 2026-10-22; diferente da situação (`MemberStatus`).
enum MemberPosition {
  MEMBER
  AUXILIARY
  DEACON
  DEACONESS
  PRESBYTER
  EVANGELIST
  PASTOR

  @@map("member_position")
}

model Member {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  congregationId String         @map("congregation_id") @db.Uuid
  fullName       String         @map("full_name")
  /// Nome sem acentos, em minúsculas: SÓ para a busca (derivado de full_name pelo domínio).
  nameKey        String         @map("name_key")
  birthDate      DateTime?      @map("birth_date") @db.Date
  /// Só dígitos (DDD + número).
  phone          String?
  email          String?
  /// JSON validado pela aplicação (value object Address). Nulo = sem endereço.
  address        Json?
  status         MemberStatus   @default(ACTIVE)
  position       MemberPosition @default(MEMBER)
  /// Preenchido quando os dados pessoais foram apagados (pedido do titular). Irreversível.
  anonymizedAt   DateTime?      @map("anonymized_at") @db.Timestamptz(3)
  /// Travamento otimista.
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  congregation  Congregation         @relation(fields: [organizationId, congregationId], references: [organizationId, id], onDelete: Restrict)
  history       MemberHistoryEvent[]
  contributions FinancialEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, congregationId])
  @@index([organizationId, nameKey])
  @@map("member")
}

/// Histórico do membro: SOMENTE-ANEXAÇÃO (o domínio nunca edita nem apaga um evento; a anonimização só limpa as notas).
model MemberHistoryEvent {
  id                 String          @id @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  memberId           String          @map("member_id") @db.Uuid
  type               MemberEventType
  /// Quando o fato aconteceu (ex.: a data do batismo). `recorded_at` é quando foi registrado.
  occurredOn         DateTime        @map("occurred_on") @db.Date
  notes              String?
  fromCongregationId String?         @map("from_congregation_id") @db.Uuid
  toCongregationId   String?         @map("to_congregation_id") @db.Uuid
  fromStatus         MemberStatus?   @map("from_status")
  toStatus           MemberStatus?   @map("to_status")
  recordedAt         DateTime        @map("recorded_at") @db.Timestamptz(3)

  member           Member        @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict)
  fromCongregation Congregation? @relation("EventFromCongregation", fields: [organizationId, fromCongregationId], references: [organizationId, id], onDelete: Restrict)
  toCongregation   Congregation? @relation("EventToCongregation", fields: [organizationId, toCongregationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, memberId, recordedAt])
  @@map("member_history_event")
}

// ---------------------------------------------------------------------------------------------------------------
// audit (ADR 0013). Trilha SOMENTE-ANEXAÇÃO: um gatilho (SQL manual na migration) recusa UPDATE e DELETE. Sem chave
// estrangeira de propósito: a trilha precisa sobreviver a qualquer outra tabela. NUNCA guarde dado pessoal aqui.
// ---------------------------------------------------------------------------------------------------------------

model AuditLog {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  /// Verbo no passado com o módulo na frente: member.viewed
  action         String
  entity         String
  entityId       String?  @map("entity_id") @db.Uuid
  /// Contexto técnico (contagens, nomes de campos). Nunca dado pessoal.
  metadata       Json?
  /// Instante do BANCO (default now()), não de quem registra.
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, occurredAt])
  @@index([organizationId, entity, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------------------------
// finance (ADR 0015). Regras que o Prisma não expressa estão em SQL manual na migration `*_finance`: CHECKs de coerência
// do lançamento, índices únicos parciais e funcionais e o GATILHO que torna `financial_entry` imutável (recusa DELETE e
// UPDATE de lançamento já decidido). Preserve-as ao alterar estas tabelas. Dinheiro em CENTAVOS inteiros (ADR 0005).
// ---------------------------------------------------------------------------------------------------------------

enum AccountKind {
  CASH
  BANK

  @@map("account_kind")
}

/// Conta e categoria nunca são apagadas: são arquivadas.
enum ArchiveStatus {
  ACTIVE
  ARCHIVED

  @@map("archive_status")
}

enum EntryDirection {
  IN
  OUT

  @@map("entry_direction")
}

/// ORDINARY: entrada ou saída comum (tem categoria). OPENING_BALANCE: saldo inicial. TRANSFER: perna de um repasse.
/// REVERSAL: estorno de outro lançamento.
enum EntryKind {
  ORDINARY
  OPENING_BALANCE
  TRANSFER
  REVERSAL

  @@map("entry_kind")
}

/// PENDING: aguardando a sede (ainda não é dinheiro). CONFIRMED: vale. REJECTED e CANCELLED: não valem.
enum EntryStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED

  @@map("entry_status")
}

/// Onde o dinheiro está: caixa ou conta bancária de UMA congregação.
model FinancialAccount {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  congregationId String        @map("congregation_id") @db.Uuid
  name           String
  kind           AccountKind
  status         ArchiveStatus @default(ACTIVE)
  /// Travamento otimista.
  version        Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  congregation Congregation     @relation(fields: [organizationId, congregationId], references: [organizationId, id], onDelete: Restrict)
  entries      FinancialEntry[]

  @@unique([organizationId, id])
  /// Alvo da chave estrangeira composta do lançamento: o lançamento não pode apontar para conta de outra congregação.
  @@unique([organizationId, id, congregationId])
  @@index([organizationId, congregationId])
  @@map("financial_account")
}

/// Classificação de entradas ou saídas, por igreja (personalizável).
model FinanceCategory {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  direction      EntryDirection
  status         ArchiveStatus  @default(ACTIVE)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries      FinancialEntry[]

  @@unique([organizationId, id])
  @@map("finance_category")
}

/// Um lançamento. IMUTÁVEL depois de decidido (gatilho no banco); a correção é um estorno (ADR 0005 e 0015).
model FinancialEntry {
  id              String         @id @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  congregationId  String         @map("congregation_id") @db.Uuid
  accountId       String         @map("account_id") @db.Uuid
  kind            EntryKind
  direction       EntryDirection
  /// Centavos, sempre positivo (o sentido está em `direction`).
  amountCents     BigInt         @map("amount_cents")
  /// O dia do fato (não o de hoje): pode ser anterior ao registro.
  occurredOn      DateTime       @map("occurred_on") @db.Date
  description     String?
  categoryId      String?        @map("category_id") @db.Uuid
  /// Quem contribuiu (dado SENSÍVEL, ADR 0006). Nulo = anônimo.
  memberId        String?        @map("member_id") @db.Uuid
  /// As duas pernas de um repasse compartilham este id.
  transferId      String?        @map("transfer_id") @db.Uuid
  reversesEntryId String?        @map("reverses_entry_id") @db.Uuid
  status          EntryStatus
  requestedBy     String         @map("requested_by") @db.Uuid
  requestedAt     DateTime       @map("requested_at") @db.Timestamptz(3)
  /// Quem aprovou ou recusou. Sempre DIFERENTE de requested_by (CHECK no banco). Nulo na entrada que nasce confirmada.
  decidedBy       String?        @map("decided_by") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?        @map("decision_note")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  account    FinancialAccount @relation(fields: [organizationId, accountId, congregationId], references: [organizationId, id, congregationId], onDelete: Restrict)
  category   FinanceCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  member     Member?          @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict)
  reverses   FinancialEntry?  @relation("EntryReversal", fields: [organizationId, reversesEntryId], references: [organizationId, id], onDelete: Restrict)
  reversedBy FinancialEntry[] @relation("EntryReversal")

  @@unique([organizationId, id])
  @@index([organizationId, congregationId, occurredOn])
  @@index([organizationId, accountId])
  @@index([organizationId, memberId, occurredOn])
  @@index([organizationId, status])
  @@index([organizationId, transferId])
  @@map("financial_entry")
}
