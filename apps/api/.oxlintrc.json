{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true
  },
  "ignorePatterns": ["src/generated/**", "dist/**"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["src/modules/*/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@prisma/*",
                  "pg",
                  "**/generated/**",
                  "**/platform/**",
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "A camada domain é TypeScript puro e não depende de ninguém: sem framework, banco, infraestrutura nem camadas externas (ADR 0001). Defina uma interface no domain e implemente na infrastructure."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/application/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@prisma/*",
                  "pg",
                  "**/generated/**",
                  "**/platform/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "A camada application só conhece o domain e portas (interfaces). Sem framework, banco ou camadas externas: a ligação com a implementação é feita no módulo Nest (ADR 0001, ADR 0009)."
              }
            ]
          }
        ]
      }
    }
  ]
}
